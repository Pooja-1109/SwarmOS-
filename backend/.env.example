# SwarmOS Backend Environment Configuration Template

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/swarmos?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_dev_key_here

# AI Service Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Meta API Integration Credentials
WHATSAPP_TOKEN=your_whatsapp_bearer_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_here
